#! /bin/bash
# 更新が発生したときのみ --deploy-hook 経由で配布する
set -eu

CERTBOT={% if certbot.venv_path | length > 0 %}{{ certbot.venv_path }}/bin/certbot{% else %}certbot{% endif %}

LIVE_DIR=/etc/letsencrypt/live/{{ certbot.domain }}
HTTPD_CONF_DIR={{ httpd.conf_dir | default(httpd.base_dir ~ '/conf') }}
HTTPD_CTL={{ httpd.ctlbin | default(httpd.base_dir ~ '/bin/apachectl') }}

install_pair() {
    # $1: LIVE_DIR 配下のファイル名, $2: 配置先
    install -m 0400 -o root -g root "${LIVE_DIR}/$1" "$2"
}

deploy() {
    # deploy hook は lineage ごとに呼ばれるため対象外はスキップ
    if [ -n "${RENEWED_LINEAGE:-}" ] && [ "${RENEWED_LINEAGE}" != "${LIVE_DIR}" ]; then
        exit 0
    fi

    # 証明書と鍵は対で配布する
    install_pair fullchain.pem "${HTTPD_CONF_DIR}/server.crt"
    install_pair privkey.pem "${HTTPD_CONF_DIR}/server.key"
{% for target in certbot.deploy_cert_to | default([]) %}

    install_pair {{ target.cert_src | default('fullchain.pem') }} {{ target.cert_dest }}
    install_pair {{ target.key_src | default('privkey.pem') }} {{ target.key_dest }}
{% if target.reload is defined %}
    {{ target.reload }}
{% endif %}
{% endfor %}

    # 確立済みの接続を切らずに再読み込みする
    "${HTTPD_CTL}" graceful
}

if [ "${1:-}" = "--deploy" ]; then
    deploy
    exit 0
fi

"${CERTBOT}" renew \
    --non-interactive \
    --server https://acme-v02.api.letsencrypt.org/directory \
    --agree-tos \
{% if certbot.cert_name | default('') | length > 0 %}
    --cert-name {{ certbot.cert_name }} \
{% endif %}
    --{{ certbot.authenticator }} \
    --deploy-hook "{{ certbot.auto_update_script_path }} --deploy"
